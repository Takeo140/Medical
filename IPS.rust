#[derive(Debug, Clone, PartialEq, Eq)]
pub enum Base { A, T, G, C }

impl Base {
    pub fn complement(&self) -> Self {
        match self {
            Base::A => Base::T,
            Base::T => Base::A,
            Base::G => Base::C,
            Base::C => Base::G,
        }
    }
}

// § 1 山中因子 (Yamanaka Factors)
#[derive(Debug, Clone, Copy, PartialEq, Eq)]
pub enum YamanakaFactor {
    OCT4,
    SOX2,
    KLF4,
    CMYC,
}

pub type FactorSet = Vec<YamanakaFactor>;

pub fn get_oskm() -> FactorSet {
    vec![YamanakaFactor::OCT4, YamanakaFactor::SOX2, YamanakaFactor::KLF4, YamanakaFactor::CMYC]
}

pub fn get_osk() -> FactorSet {
    vec![YamanakaFactor::OCT4, YamanakaFactor::SOX2, YamanakaFactor::KLF4]
}

// § 2 プロモーター配列
pub fn promoter_seq(f: &YamanakaFactor) -> Vec<Base> {
    use Base::*;
    match f {
        YamanakaFactor::OCT4 => vec![G,G,C,C,G,C,T,G,G,G,G,C,G,C,G],
        YamanakaFactor::SOX2 => vec![A,T,T,G,T,T,G,T,T,A,T,T,G,T,T],
        YamanakaFactor::KLF4 => vec![G,G,G,C,G,G,G,G,C,G,G,G,C,G,G],
        YamanakaFactor::CMYC => vec![C,A,C,G,T,G,C,A,C,G,T,G,C,A,C],
    }
}

// § 3 細胞状態 (CellState)
#[derive(Debug, Clone, PartialEq, Eq)]
pub enum CellState {
    Somatic(String),
    PartialReprog(u8), // PluripotencyScore: 0-10
    IPSC(String),      // Clone ID
}

// § 4 リプログラミングプロトコル
#[derive(Debug, Clone)]
pub struct ReprogProtocol {
    pub factors: FactorSet,
    pub delivery: String,
    pub culture_days: u32,
    pub feeder_free: bool,
}

impl ReprogProtocol {
    pub fn is_valid(&self) -> bool {
        self.factors.contains(&YamanakaFactor::OCT4) &&
        self.factors.contains(&YamanakaFactor::SOX2) &&
        !self.delivery.is_empty() &&
        self.culture_days >= 14
    }
}

// § 5 多能性マーカー検証
#[derive(Debug, Clone, PartialEq, Eq)]
pub enum PluripotencyMarker {
    NANOG, OCT4Expr, SOX2Expr, SSEA4, TRA160
}

pub struct MarkerProfile {
    pub expressed: Vec<PluripotencyMarker>,
}

impl MarkerProfile {
    pub fn required() -> Vec<PluripotencyMarker> {
        vec![
            PluripotencyMarker::NANOG,
            PluripotencyMarker::OCT4Expr,
            PluripotencyMarker::SOX2Expr,
            PluripotencyMarker::SSEA4,
        ]
    }

    pub fn is_certified(&self) -> bool {
        Self::required().iter().all(|m| self.expressed.contains(m))
    }
}

// § 6 状態遷移関数 (再プログラミング写像)
fn protocol_score(p: &ReprogProtocol) -> u8 {
    let base_score: u8 =
        if p.factors == get_oskm()      { 8 }
        else if p.factors == get_osk()  { 6 }
        else { (p.factors.len() * 2).min(255) as u8 };

    let day_bonus: u8 = if p.culture_days >= 21 { 2 } else { 0 };

    // [FIX] + → saturating_add: debug ビルドのオーバーフローパニックを防止
    base_score.saturating_add(day_bonus).min(10)
}

pub fn reprogram(src: &CellState, p: &ReprogProtocol) -> CellState {
    if !p.factors.contains(&YamanakaFactor::OCT4) || !p.factors.contains(&YamanakaFactor::SOX2) {
        return src.clone();
    }

    let score = protocol_score(p);
    if score >= 10 {
        CellState::IPSC(format!("clone_{}_d{}", p.delivery, p.culture_days))
    } else {
        CellState::PartialReprog(score)
    }
}

// § 8 逆相補配列ユーティリティ（Lean §8 対応・未移植を補完）
pub fn bases_to_string(bases: &[Base]) -> String {
    bases.iter().map(|b| match b {
        Base::A => 'A',
        Base::T => 'T',
        Base::G => 'G',
        Base::C => 'C',
    }).collect()
}

pub fn promoter_template_strand(f: &YamanakaFactor) -> Vec<Base> {
    promoter_seq(f).iter().rev().map(|b| b.complement()).collect()
}

pub fn oct4_promoter_pair() -> (Vec<Base>, Vec<Base>) {
    let sense    = promoter_seq(&YamanakaFactor::OCT4);
    let template = promoter_template_strand(&YamanakaFactor::OCT4);
    (sense, template)
}

// § 9 実行メインプロセス
fn main() {
    let fibroblast = CellState::Somatic("human_fibroblast".to_string());

    let protocol = ReprogProtocol {
        factors: get_oskm(),
        delivery: "episomal_vector".to_string(),
        culture_days: 28,
        feeder_free: true,
    };

    println!("--- Reprogramming Pipeline ---");

    // [FIX] reprogram 結果の iPSC 到達を main でも確認
    let result = reprogram(&fibroblast, &protocol);
    println!("Final State: {:?}", result);
    assert!(
        matches!(result, CellState::IPSC(_)),
        "reprogram failed: expected IPSC, got {:?}", result
    );

    let profile = MarkerProfile {
        expressed: vec![
            PluripotencyMarker::NANOG,
            PluripotencyMarker::OCT4Expr,
            PluripotencyMarker::SOX2Expr,
            PluripotencyMarker::SSEA4,
            PluripotencyMarker::TRA160,
        ],
    };

    assert!(profile.is_certified(), "Certification failed");
    println!("Certification: PASSED (Logic Verified by Yamamoto-DNA-Engine)");
}

// § 7 単体テスト（Lean 定理 7.1 / 7.2 / 7.3 / pipeline_certified 対応）
// [FIX] テストモジュールが完全に欠落していたため追加
#[cfg(test)]
mod tests {
    use super::*;

    // theorem 7.1: OSKM × 21日培養 → iPSC に到達する
    #[test]
    fn oskm_21days_yields_ipsc() {
        let p = ReprogProtocol {
            factors: get_oskm(),
            delivery: "retrovirus".to_string(),
            culture_days: 21,
            feeder_free: true,
        };
        let src = CellState::Somatic("fibroblast".to_string());
        let result = reprogram(&src, &p);
        assert!(
            matches!(result, CellState::IPSC(_)),
            "expected IPSC, got {:?}", result
        );
    }

    // theorem 7.2: 必須因子欠如 → 状態不変
    #[test]
    fn missing_oct4_no_change() {
        let p = ReprogProtocol {
            factors: vec![YamanakaFactor::SOX2, YamanakaFactor::KLF4],
            delivery: "episomal".to_string(),
            culture_days: 21,
            feeder_free: false,
        };
        let src = CellState::Somatic("fibroblast".to_string());
        assert_eq!(reprogram(&src, &p), src);
    }

    // theorem 7.3: 有効プロトコルは is_valid を満たす
    #[test]
    fn oskm_protocol_valid() {
        let p = ReprogProtocol {
            factors: get_oskm(),
            delivery: "retrovirus".to_string(),
            culture_days: 14,
            feeder_free: true,
        };
        assert!(p.is_valid());
    }

    // theorem pipeline_certified: iPS認定基準を満たす
    #[test]
    fn pipeline_certified() {
        let profile = MarkerProfile {
            expressed: vec![
                PluripotencyMarker::NANOG,
                PluripotencyMarker::OCT4Expr,
                PluripotencyMarker::SOX2Expr,
                PluripotencyMarker::SSEA4,
                PluripotencyMarker::TRA160,
            ],
        };
        assert!(profile.is_certified());
    }

    // 追加: 部分リプログラミングのスコア確認
    #[test]
    fn osk_partial_reprog() {
        let p = ReprogProtocol {
            factors: get_osk(),
            delivery: "episomal".to_string(),
            culture_days: 14, // day_bonus なし
            feeder_free: false,
        };
        let src = CellState::Somatic("fibroblast".to_string());
        assert_eq!(reprogram(&src, &p), CellState::PartialReprog(6));
    }
}
